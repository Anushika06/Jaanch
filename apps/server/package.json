{
  "name": "@jaanch/server",
  "version": "1.0.0",
  "private": true,
  "description": "Jaanch API server: web channel, WhatsApp (Twilio) channel, job worker and ingestion CLI.",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "cli": "tsx src/cli.ts",
    "cli:prod": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@jaanch/core": "workspace:*",
    "@jaanch/db": "workspace:*",
    "@jaanch/llm": "workspace:*",
    "@jaanch/sources": "workspace:*",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "libphonenumber-js": "^1.13.14",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "tldts": "^7.4.16",
    "twilio": "^6.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
