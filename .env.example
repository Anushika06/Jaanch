# ─────────────────────────────────────────────────────────────────────────────
# Jaanch configuration. Copy to `.env` for local development (never commit .env).
# Hosted deployments set these in the provider's dashboard instead.
# Every variable is validated at start-up (apps/server/src/config.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime ---------------------------------------------------------------------
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# Public HTTPS origin of the API server. Locally: your cloudflared tunnel URL when testing WhatsApp.
PUBLIC_BASE_URL=http://localhost:8787
# Where the web app is served, if not by this server (e.g. https://jaanch.vercel.app).
WEB_BASE_URL=
# Comma-separated origins allowed to call the API cross-origin (only if the web app is elsewhere).
CORS_ORIGINS=

# Security --------------------------------------------------------------------
# Required in production: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
# Optional: enables /admin/* endpoints (ingest, sweep, status) with "Authorization: Bearer <token>".
ADMIN_TOKEN=

# Database --------------------------------------------------------------------
# Postgres connection string (e.g. Neon). Leave empty locally to use the embedded database in DATA_DIR.
DATABASE_URL=
DATA_DIR=.data

# Official sources ------------------------------------------------------------
# live = real SEBI/RBI data. fixture = FICTIONAL development data (refused in production).
SOURCE_MODE=live
SEBI_LIVE_LOOKUPS=true
RDAP_LOOKUPS=true
# auto: refresh snapshots on boot when older than INGEST_MAX_AGE_HOURS | always | never
INGEST_ON_BOOT=auto
INGEST_MAX_AGE_HOURS=24

# Language model: NVIDIA NIM (https://build.nvidia.com) ------------------------
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Leave empty for the defaults chosen by the live probe (packages/llm/src/index.ts).
LLM_VISION_MODEL=
LLM_TEXT_MODEL=
LLM_NARRATOR_MODEL=
LLM_TIMEOUT_MS=90000
OCR_CONSENSUS=true
NARRATIVE=true

# WhatsApp (optional, off) ---------------------------------------------------
# Jaanch is a web product. A WhatsApp channel exists in the code but needs a verified Meta
# business (Cloud API) or a paid Twilio account, so it is off. none | auto | meta | twilio
WHATSAPP_PROVIDER=none

# Option A: Meta WhatsApp Cloud API (free test number; see docs/deployment.md).
# Temporary tokens from "API Setup" expire after about a day; use a system-user token to deploy.
META_WA_ACCESS_TOKEN=
# WhatsApp → API Setup → "Phone number ID" (an id, not the phone number).
META_WA_PHONE_NUMBER_ID=
# App settings → Basic → App secret. Verifies the X-Hub-Signature-256 of every webhook.
META_APP_SECRET=
# Any random string; enter the same value in WhatsApp → Configuration → Webhook → Verify token.
META_WA_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Shown on the web page; looked up automatically when empty.
META_WA_DISPLAY_NUMBER=
META_VALIDATE_SIGNATURE=true

# Option B: Twilio (the WhatsApp Sandbox needs an upgraded account; trials are template-only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox sender. For a production sender use your number, or TWILIO_MESSAGING_SERVICE_SID instead.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=
# Shown on the web page so people can join the sandbox, e.g. "join letter-now".
TWILIO_SANDBOX_JOIN_CODE=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_DELETE_INBOUND_MEDIA=true
TWILIO_CATCHUP_ON_BOOT=true

# Privacy & limits -------------------------------------------------------------
REPORT_TTL_DAYS=7
MEDIA_TTL_MINUTES=30
MAX_UPLOAD_MB=8
MAX_IMAGES=5
WEB_INVESTIGATIONS_PER_HOUR=20
WHATSAPP_INVESTIGATIONS_PER_HOUR=15

# Worker ----------------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
# 0 = event-driven (recommended: lets serverless Postgres sleep when idle)
WORKER_POLL_MS=0
